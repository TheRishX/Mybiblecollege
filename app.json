{
  "expo": {
    "name": "Spirit and Truth College",
    "slug": "spirit-truth-college",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3366F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spirittruth.college"
    },
    "android": {
      "package": "com.spirittruth.college",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3366F0"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Spirit and Truth College",
      "shortName": "Bible College",
      "themeColor": "#3366F0",
      "backgroundColor": "#F4F7FF",
      "description": "Your two-year self-study Bible college: daily tasks, notes and progress."
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
